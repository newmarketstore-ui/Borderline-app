// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// 切到 Supabase Postgres。DATABASE_URL 见 .env。
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// 员工每日手动录入：每个门店每天一条。
model ManualDailyMetric {
  id           String @id @default(cuid())
  shopDomain   String
  businessDate String // YYYY-MM-DD（America/Toronto）
  timezone     String @default("America/Toronto")

  locationId   String
  locationName String?

  // 到店总组数（客群组，一伙同行算 1 组）
  storeVisitGroups Int @default(0)

  // 各渠道主来源组数；unknown 由服务端按 总数-已知合计 计算，不让员工填
  channelWalkIn         Int @default(0)
  channelGoogleMaps     Int @default(0)
  channelMeta           Int @default(0)
  channelTiktok         Int @default(0)
  channelXiaohongshu    Int @default(0)
  channelReferral       Int @default(0)
  channelRepeatCustomer Int @default(0)
  channelWebsite        Int @default(0)
  channelPhoneSms       Int @default(0)
  channelOther          Int @default(0)
  channelUnknown        Int @default(0)

  // 客流影响因素（结构化多选标签）+ 自由备注
  trafficFactors String[] @default([])
  notes          String?

  submittedByName  String?
  submittedByEmail String?
  submittedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  audits ManualDailyMetricAudit[]

  @@unique([shopDomain, businessDate, locationId])
  @@index([shopDomain, businessDate])
  @@index([shopDomain, locationId])
}

// 审计日志：每次 create/update 写一条，记录前后值，便于追溯改数。
model ManualDailyMetricAudit {
  id         String   @id @default(cuid())
  metricId   String
  action     String // create | update
  beforeJson Json?
  afterJson  Json
  actorName  String?
  actorEmail String?
  createdAt  DateTime @default(now())

  metric ManualDailyMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@index([metricId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// 会员积分（Loyalty）底座 —— 设计见 reports/BorderlineAI应用_会员_打蜡服务_AI客服_架构方案_2026-10-27.md §2 / §7
// 原则：PointsLedger 只追加不改不删；余额 = ledger 求和，Member 上的 *Cached 只是缓存。
// 类型字段（type / status / channel …）用 String 存，取值写在注释里，方便以后加值不用迁移 enum。
// ─────────────────────────────────────────────────────────────────────────────

// 会员：主键语义 = Shopify Customer GID；邮箱 / 手机只做辅助匹配。
model Member {
  id                 String    @id @default(cuid())
  shopifyCustomerId  String    @unique // gid://shopify/Customer/123
  shopDomain         String
  email              String?
  phone              String?
  firstName          String?
  lastName           String?
  tier               String    @default("standard") // standard | paid
  paidUntil          DateTime?
  balanceCached      Int       @default(0) // 可用积分 = sum(delta) where availableAt <= now
  pendingCached      Int       @default(0) // 待确认积分 = sum(delta) where availableAt > now
  source             String // order | appstle_migrated | staff | customer_update
  tags               String[]  @default([]) // Shopify 客户标签快照（会员判断看 LoyaltyConfig.memberTag）
  membershipSyncedAt DateTime? // 上次从 Shopify 拉标签 + appstle_membership.subscriptions 的时间；null = 会员身份未知
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  ledger      PointsLedger[]
  redemptions Redemption[]
  memberships Membership[]

  @@index([shopDomain, email])
  @@index([shopDomain, phone])
  @@index([shopDomain, lastName, firstName])
}

// 积分流水：只追加。幂等键 = (type, referenceId)。
// Postgres 唯一约束里 NULL 互不相等，所以 referenceId 为空的行（理论上只有极少数手工行）不受约束；
// 需要幂等的行（earn / refund_reverse / redeem / migrate / staff adjust）一律带 referenceId。
model PointsLedger {
  id            String   @id @default(cuid())
  memberId      String
  delta         Int // +赚 / −扣，可让余额变负（退款扣回）
  type          String // earn | redeem | redeem_release | refund_reverse | adjust | expire | migrate
  referenceType String? // order | refund | redemption | staff_adjust | appstle_snapshot
  referenceId   String? // 订单 GID / 退款 GID / 核销 ID / 表单幂等键
  orderId       String? // 关联订单 GID（earn / refund_reverse / redeem 用，方便按单汇总扣回）
  orderName     String? // #22274
  note          String?
  meta          Json? // 计算明细（可计分金额、逐行拆分、当时的规则快照），退款按比例扣回要用
  availableAt   DateTime @default(now()) // > now 视为待确认（pendingDays > 0 时）
  createdBy     String // system | 员工邮箱
  createdAt     DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([type, referenceId])
  @@index([memberId, createdAt])
  @@index([orderId])
}

// 兑分：积分换一次性折扣（线上专属码 / POS 自定义折扣）。
model Redemption {
  id             String    @id @default(cuid())
  memberId       String
  points         Int
  amountCents    Int
  currency       String    @default("CAD")
  method         String    @default("discount_code") // discount_code | store_credit | cart_discount（POS 当场抵扣，无码） | cart_discount（POS 当场抵扣，无码）
  discountCodeId String? // gid://shopify/DiscountCodeNode/…
  discountCode   String?
  storeCreditTransactionId String? // gid://shopify/StoreCreditAccountCreditTransaction/…
  storeCreditAccountId     String?
  storeCreditReversalId    String? // 店员撤销时的 debit 交易
  orderId        String?
  status         String    @default("issued") // issued | used | cancelled | expired | credited（store_credit 已到账）
  channel        String // web | pos
  issuedBy       String // system | 员工邮箱
  expiresAt      DateTime?
  idempotencyKey String?   @unique // 店员表单键：同一次提交重放只发一张码
  meta           Json? // 报价明细（倍数、税率、取整方式、命中的窗口）
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([discountCode])
  @@index([status, expiresAt])
}

// 积分规则：每个店一行（老板拍板后在 /app/loyalty/settings 改）。
model LoyaltyConfig {
  id                         String   @id @default(cuid())
  shopDomain                 String   @unique
  // ── 老板 2026-10-29 定规：普通会员（任何留资下单的客人）$1 = 1 分；付费会员 $1 = 10 分；1000 分 = $10 Store Credit ──
  pointsPerDollar            Decimal  @default(1) @db.Decimal(10, 4)
  redeemPointsPerDollar      Int      @default(100) // 100 分 = $1（1000 分 = $10）
  minRedeemPoints            Int      @default(1000)
  redeemStepPoints           Int      @default(1000)
  excludedProductTypes       String[] @default([])
  excludedTags               String[] @default(["Gift Card", "Service"])
  earnOnShipping             Boolean  @default(false)
  earnOnTax                  Boolean  @default(false)
  pendingDays                Int      @default(0)
  expiryMonths               Int? // expiryMode = inactivity 时：N 个月没有任何赚分 / 兑换 → 余额清零
  expiryMode                 String   @default("off") // off | inactivity
  paidTierMultiplier         Decimal  @default(10) @db.Decimal(6, 3) // 付费会员倍数（10 分/$）
  earnRequiresMember         Boolean  @default(false) // 老板 10/29：任何留资客人都赚分
  memberTag                  String   @default("gold-membership") // 付费会员标签（Appstle Memberships 打的）
  membershipProductTag       String   @default("Membership") // 买带此标签的商品 = 开通付费会员
  membershipMonths           Int      @default(12) // 自己记的付费会员时长
  excludeDiscountedItems     Boolean  @default(false)
  redeemMethod               String   @default("store_credit") // store_credit | discount_code
  storeCreditExpiryMonths    Int? // null = Store Credit 不过期
  redeemAmountIsTaxInclusive Boolean  @default(false) // 只对 discount_code 有意义（Store Credit 直接抵总价）
  assumedTaxRate             Decimal  @default(0.13) @db.Decimal(6, 4)
  redeemRounding             String   @default("nearest_cent") // nearest_cent | floor_cent | up_10_cents
  redeemRequiresMember       Boolean  @default(false)
  redeemCodePrefix           String   @default("POINTS")
  redeemExpiryHours          Int      @default(24) // discount_code 方式的码有效期
  signupBonusPoints          Int      @default(0) // 首次建档送分（0 = 不送）
  // POS 兑换方式开关（老板 10/29：一键换 Store Credit + 一键抵扣当前购物车，后台可配）
  posAllowStoreCredit        Boolean  @default(true)
  posAllowCartDiscount       Boolean  @default(true)
  cartDiscountExpiryMinutes  Int      @default(120) // 抵扣了购物车但没成交：N 分钟后自动退分
  migrationPointsMultiplier  Decimal  @default(10) @db.Decimal(6, 3) // Appstle 10 分 = $1 → 我们 100 分 = $1，旧分 ×10 保值
  updatedBy                  String?
  updatedAt                  DateTime @updatedAt
}

// 付费会员资格：一人可多条（Appstle 合约 / 手工 / 以后自家会员商品订单）。
// 会员判断 = 客户标签含 LoyaltyConfig.memberTag 或 任一条 status = active 且未过 endsAt（见 app/lib/membership.ts）。
model Membership {
  id         String    @id @default(cuid())
  memberId   String
  source     String // appstle | manual | shopify_order
  externalId String? // Appstle 合约 id / 订单 GID；同 source 内唯一，同步时按它 upsert
  planName   String?
  status     String // active | cancelled | expired
  startedAt  DateTime?
  renewsAt   DateTime?
  endsAt     DateTime?
  raw        Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([memberId])
}

// 兑换倍数窗口（Appstle「Double Redeem Every Wednesday」= 周三 ×2，只限 POS、只限会员）。
// dayOfWeek 0 = 周日 … 6 = 周六，按 timezone 当地时间；startHour 含、endHour 不含，都空 = 全天。
model RedeemWindow {
  id                     String   @id @default(cuid())
  shopDomain             String
  label                  String?
  dayOfWeek              Int
  startHour              Int?
  endHour                Int?
  timezone               String   @default("America/Toronto")
  multiplier             Decimal  @default(2) @db.Decimal(6, 3)
  channels               String[] @default(["pos"]) // pos | web；空 = 所有渠道
  memberOnly             Boolean  @default(true)
  // Appstle 周三规则要求「订单金额 ≥ 折扣金额」：true 时发码带 minimumRequirement.subtotal = 折扣额（POS 也认）
  minSpendEqualsDiscount Boolean  @default(false)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([shopDomain])
}

// 迁移当天每个客户 Appstle 原始 JSON 原样留底（只读）。
model MigrationSnapshot {
  id                String   @id @default(cuid())
  shopifyCustomerId String
  source            String   @default("appstle_loyalty")
  raw               Json
  importedAt        DateTime @default(now())
  ledgerId          String? // 对应写入的 migrate 流水

  @@unique([source, shopifyCustomerId])
}

// Webhook 原始落库：webhookId = X-Shopify-Webhook-Id，重发时唯一约束挡住重复。
model WebhookEvent {
  id          String    @id @default(cuid())
  webhookId   String    @unique
  topic       String
  shopDomain  String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  status      String    @default("received") // received | queued | done | failed
  error       String?

  @@index([status, receivedAt])
  @@index([shopDomain, topic, receivedAt])
}

// 应用模块开关（老板 2026-10-29：先只开会员积分，门店日报先关；以后打蜡工单 / AI 客服也走这里）
model AppModule {
  id         String   @id @default(cuid())
  shopDomain String
  key        String // loyalty | store_metrics | service_tickets | ai_support
  enabled    Boolean  @default(false)
  updatedBy  String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([shopDomain, key])
}
